# ============================================================
# Variáveis de ambiente do Sellbird (chaves e senhas)
# Copie este arquivo para .env e preencha seus valores:  cp .env.example .env
# Nunca envie o .env para o git: ele já está no .gitignore.
# Escolha UM provedor de e-mail abaixo (e defina channels.email.provider no
# sellbird.yaml igual): gmail (recomendado), microsoft, smtp ou instantly.
# O resto é opcional, mas um verificador de e-mail (Reoon/ZeroBounce) é
# muito recomendado: sem ele nenhum e-mail encontrado é enviado.
# ============================================================

# ------------------------------------------------------------
# PROVEDOR DE E-MAIL: como o Sellbird envia e lê as respostas. Escolha um.
#
# Opção A: Gmail / Google Workspace  [RECOMENDADO para até ~50 e-mails frios/dia]
#   Defina provider: gmail no sellbird.yaml. Use uma caixa num domínio
#   SECUNDÁRIO só para envio (nunca o principal), com SPF/DKIM/DMARC.
#   1. Google Cloud Console → novo projeto → ative a Gmail API
#   2. Credenciais → ID do cliente OAuth → tipo "App para computador"
#   3. Cole o ID e o segredo abaixo e rode: sellbird gmail auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Opção B: qualquer caixa SMTP + IMAP  [Hostinger, Locaweb, Zoho, KingHost,
#   AgentMail, Fastmail, senha de app do Workspace]
#   Defina provider: smtp no sellbird.yaml. IMAP_* usa os valores de SMTP_*
#   quando ficar em branco.
#   Exemplo Hostinger: SMTP_HOST=smtp.hostinger.com  SMTP_PORT=587
#                      IMAP_HOST=imap.hostinger.com  IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Opção B2: Microsoft 365 / Outlook  [caixa no Exchange Online]
#   Defina provider: microsoft no sellbird.yaml. O Exchange Online não
#   aceita mais senha no IMAP, então o login é por OAuth:
#   1. entra.microsoft.com → Registros de aplicativo → Novo registro
#      ("somente este diretório organizacional"; URI de redirecionamento
#      "Cliente público/nativo", valor http://localhost:8766)
#   2. Cole abaixo o ID do aplicativo (cliente) e o ID do diretório (locatário)
#   3. Rode: sellbird microsoft auth   (depois: sellbird microsoft test)
M365_CLIENT_ID=
M365_TENANT_ID=

# Opção C: Instantly, plataforma de e-mail frio  [antigo]
# Onde pegar: https://app.instantly.ai → Settings → Integrations → API Keys
# A API exige o plano Growth do Instantly ou superior.
INSTANTLY_API_KEY=

# ------------------------------------------------------------
# LinkedIn: prospecção por automação de navegador  [OPCIONAL]
# Login da conta do LinkedIn que o Sellbird vai usar com o Playwright.
# ATENÇÃO: automação viola os Termos de Uso do LinkedIn e pode restringir ou
# banir a conta. Use uma conta que você aceita perder, mantenha os limites
# padrão, ou deixe em branco: o Sellbird prospecta pela web e pelos sites
# das empresas.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ------------------------------------------------------------
# Cloudflare Browser Rendering: leitura profunda de sites no treinamento  [OPCIONAL]
# Permite ler seu próprio site com JavaScript ao rodar `sellbird train`.
# Onde pegar:
#   Account ID: https://dash.cloudflare.com → barra lateral de qualquer zona, ou na URL
#   API Token:  https://dash.cloudflare.com/profile/api-tokens → Create Token
#               → permissão "Browser Rendering: Edit"
# Custo: ~US$ 5/mês no plano Workers pago (~12.000 páginas). O plano grátis tem limites.
# Sem isso, o Sellbird usa o leitor HTTP próprio (sem JavaScript).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------
# Verificação de e-mail: como o Sellbird confirma que o endereço existe antes
# de enviar. Ele descobre o PADRÃO de e-mail de cada empresa e verifica UM
# candidato (a sondagem SMTP direta não funciona mais com Google Workspace /
# Microsoft 365). UMA destas chaves basta; as duas dão mais cobertura. Sem
# nenhuma, os endereços ficam como "guess" (palpite) e nunca são enviados.

# Reoon: melhor plano grátis para verificar e-mail frio (600 por mês,
# renova todo mês + 100 que não expiram). Bom para marcar domínios aceita-tudo.
# Onde pegar: https://reoon.com/email-verifier → cadastro → API
REOON_API_KEY=

# ZeroBounce: 100 grátis/mês. O motor de 2026 é o confiável para domínios
# aceita-tudo do Microsoft 365 / Google Workspace; o Sellbird manda esses
# domínios para ele. https://zerobounce.net → API
ZEROBOUNCE_API_KEY=

# Hunter.io: descoberta de e-mail + busca de padrão  [OPCIONAL]
# Plano grátis: 50 verificações + 25 buscas de domínio por mês. A busca de
# domínio é o jeito mais barato de descobrir o padrão de e-mail da empresa
# (usada primeiro, então o Sellbird verifica um endereço em vez de chutar seis).
# Onde pegar: https://hunter.io → cadastro → API → API Keys
HUNTER_API_KEY=
# Buscas de domínio por mês em todo o Sellbird. 25 é o plano grátis do
# Hunter; coloque o limite do seu plano se você pagar.
HUNTER_MONTHLY_SEARCHES=25

# Precleared: checagem de conformidade por destinatário  [OPCIONAL]
# Só é usado com compliance.precleared.enabled: true no sellbird.yaml.
# Ainda não cobre o Brasil (para empresas brasileiras vale a LGPD).
# Sem chave: 10 checagens por dia. Chave grátis: 25 por dia. Pacotes pagos além disso.
# Onde pegar: https://precleared.dev/get-key
PRECLEARED_API_KEY=

# TrulyInbox: serviço de aquecimento (recomendado)  [OPCIONAL]
# Deixa o `sellbird warmup` ver se a sua caixa está aquecida de verdade.
# Mais fácil: rode `sellbird trulyinbox connect`, que confere a chave e preenche aqui.
# TrulyInbox: https://trulyinbox.com/?via=sellbird  (a API começa no plano Starter)
TRULYINBOX_API_KEY=
TRULYINBOX_WORKSPACE_ID=

# ------------------------------------------------------------
# DESCOBERTA: onde o Sellbird encontra empresas.  [TUDO OPCIONAL]
# A fonte padrão (OpenStreetMap) não precisa de conta:
#     sellbird discover
# Veja todas as opções, com preços reais, em:
#     sellbird discover --providers      (ou na aba Descobrir do painel)
# ------------------------------------------------------------

# DataForSEO: os dados de empresas locais e de busca mais baratos.
# Onde pegar: https://app.dataforseo.com/api-access
#   ATENÇÃO: a senha da API é gerada lá. NÃO é a senha da sua conta.
#   US$ 1 de crédito no cadastro; depósito mínimo de US$ 50 para usar de verdade.
# Custo: US$ 0,372 por 1.000 empresas; US$ 0,006 por busca orgânica com
# profundidade 30 e US$ 0,002 por busca no Maps (endpoints Live).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Coloque qualquer valor para mandar tudo para o sandbox grátis da DataForSEO.
# Mesmo formato de resposta, dados de mentira, nunca cobra: o jeito certo de testar.
DATAFORSEO_SANDBOX=

# Serper.dev: API de busca do Google, usada na descoberta e nas buscas do Scout.
# Onde pegar: https://serper.dev → cadastro → Dashboard → API Key
# Custo: 2.500 buscas grátis sem cartão, depois um pacote pré-pago de US$ 50
# (créditos expiram em 6 meses). Sem ela o Sellbird usa DuckDuckGo/Bing,
# que têm muito limite de uso.
SERPER_API_KEY=

# Scavio: Google Maps e Google Search com uma chave só.
# Onde pegar: https://scavio.dev → cadastro → Dashboard → API Keys
# Custo: 50 créditos grátis no cadastro, sem cartão. Depois US$ 30/mês por 7.000 créditos.
# Cada página custa 1 crédito (até 20 resultados do Maps ou 10 da busca). As
# estimativas usam o preço avulso de US$ 0,01; assinaturas saem mais barato.
# Escolha scavio_maps ou scavio_search no `sellbird discover`.
SCAVIO_API_KEY=

# TinyFish: pesquisa na web para a descoberta e o Scout. Não registra posição.
# Onde pegar: https://agent.tinyfish.ai/api-keys
# Custo: grátis, sem cartão. Limites: 30 buscas por minuto, 500 por hora.
TINYFISH_API_KEY=

# ------------------------------------------------------------
# Calendly: agendamento automático  [AINDA NÃO USADO, está no roadmap]
# CALENDLY_API_KEY=
